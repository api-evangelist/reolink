{
  "opencollection": "1.0.0",
  "info": {
    "name": "Reolink Camera HTTP AI Network API",
    "version": "8.0"
  },
  "request": {
    "auth": {
      "type": "apikey",
      "key": "token",
      "value": "{{token}}",
      "placement": "query"
    }
  },
  "items": [
    {
      "info": {
        "name": "Network",
        "type": "folder"
      },
      "items": [
