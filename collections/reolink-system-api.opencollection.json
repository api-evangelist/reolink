{
  "opencollection": "1.0.0",
  "info": {
    "name": "Reolink Camera HTTP AI System API",
    "version": "8.0"
  },
  "request": {
    "auth": {
      "type": "apikey",
      "key": "token",
      "value": "{{token}}",
      "placement": "query"
    }
  },
  "items": [
    {
      "info": {
        "name": "System",
        "type": "folder"
      },
      "items": [
        {
          "info": {
            "name": "Get device information",
            "type": "http"
          },
          "http": {
            "method": "POST",
            "url": "https://{camera_ip}/cgi-bin/api.cgi?cmd=GetDevInfo&token=:token",
            "params": [
              {
                "name": "token",
                "value": "",
                "type": "path",
                "description": "Authentication token obtained from the Login command"
              }
            ],
            "body": {
              "type": "json",
              "data": "{}"
            }
          },
          "docs": "Retrieves device information including model, hardware version, firmware version, device name, and channel count."
        },
        {
          "info": {
            "name": "Get user abilities and permissions",
            "type": "http"
          },
          "http": {
            "method": "POST",
            "url": "https://{camera_ip}/cgi-bin/api.cgi?cmd=GetAbility&token=:token",
            "params": [
              {
                "name": "token",
                "value": "",
                "type": "path",
                "description": "Authentication token obtained from the Login command"
              }
            ],
            "body": {
              "type": "json",
              "data": "{}"
            }
          },
          "docs": "Retrieves the abilities and permissions available to the authenticated user."
        },
        {
          "info": {
            "name": "Get device time",
            "type": "http"
