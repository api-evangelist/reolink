          "info": {
            "name": "Get network port configuration",
            "type": "http"
          },
          "http": {
            "method": "POST",
            "url": "https://{camera_ip}/cgi-bin/api.cgi?cmd=GetNetPort&token=:token",
            "params": [
              {
                "name": "token",
                "value": "",
                "type": "path",
                "description": "Authentication token obtained from the Login command"
              }
            ],
            "body": {
              "type": "json",
              "data": "{}"
            }
          },
          "docs": "Retrieves network port settings including HTTP, HTTPS, RTSP, and ONVIF ports."
        },
        {
